# Set to your Railway backend URL with /api suffix
# Without this, the app falls back to http://127.0.0.1:8000/api which is
# blocked as mixed content on HTTPS and breaks ALL authentication.
VITE_API_URL=https://YOUR-BACKEND.up.railway.app/api

# TTS Microservice — set to your Railway deployment URL in production
VITE_TTS_URL=http://localhost:8001